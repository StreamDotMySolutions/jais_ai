# Copy this to /etc/default/jais-backup on the server (chmod 600, root-owned).
APP_ROOT=/var/www/jais_ai
BACKUP_ROOT=/var/backups/jais

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jais_ai
DB_USER=jais_backup
DB_PASS=change-me

RETENTION_DAYS=14

# Optional offsite copy. Leave empty to skip.
# S3_BUCKET=s3://jais-backups/hotline
